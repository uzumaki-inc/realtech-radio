{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git push)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-push.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*__(push_files|create_or_update_file|merge_pull_request|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-push.sh"
          }
        ]
      }
    ]
  }
}
